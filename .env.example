# Database Configuration
DATABASE_URL=postgresql://flowshield:flowshield_secret@localhost:5432/flowshield
# SQLite fallback for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./flowshield.db

# Authentication
JWT_SECRET=flowshield_sih_2026_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
ENVIRONMENT=development
DEMO_MODE=true
SCENARIO_SEED=26192
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Model Paths
MODEL_PATH=ml/models/xgb_flood_model.joblib
METADATA_PATH=ml/models/model_metadata.json

# AI Providers (Optional — automatic fallback to physical template engine if omitted)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=auto
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Weather & Hydrometeorological API
TOMORROW_API_KEY=your_tomorrow_io_api_key_here
TOMORROW_API_BASE_URL=https://api.tomorrow.io/v4
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# River Hydrology API (Optional)
RIVER_API_KEY=

# AgroMonitoring API (Required for Soil Moisture satellite telemetry)
AGRO_API_KEY=

# Flood Model API (Optional remote inference endpoint)
MODEL_API_URL=

# Data Refresh & Polling Interval (in milliseconds, e.g. 300000 = 5 minutes)
DATA_REFRESH_INTERVAL_MS=300000
