graph TD
    %% Flowshield Full Subsystem Dependency Graph (v4.0.0)
    %% Generated by Graphify for SIH 2026 Problem Statement 26192

    subgraph Client_Layer ["Client Layer (Web Frontend - Vite/React/TS)"]
        UI_Pages["Pages: Dashboard, CommandCenter, TimelineWorkspace, ResponderPage, CitizenWarning, About, Login"]
        UI_Comp["Components: TimelineView, PredictiveTimelineChart, MultiHorizonGrid, MapView, RiskGauges, RouteNavigator, AlertFeed"]
        UI_Hooks["Hooks & State: useTimelineData, useFloodData, useSimulation, useWebSocket, useSpatialLayers, useAuth"]
        UI_API["API Client: Axios / Fetch Layer (Endpoints: /api/v1/*, /api/ai/risk)"]
        
        UI_Pages --> UI_Comp
        UI_Comp --> UI_Hooks
        UI_Hooks --> UI_API
    end

    subgraph Gateway_API ["API Gateway & Routing Layer (FastAPI - 17 Routers)"]
        Router_Health["/health, /system/status"]
        Router_Auth["/api/v1/auth (JWT / RBAC)"]
        Router_Forecast["/api/v1/risk/forecast (Detailed & Locations)"]
        Router_Sensors["/api/v1/villages, /api/v1/telemetry"]
        Router_Catchment["/api/v1/map (GeoJSON layers)"]
        Router_Alerts["/api/v1/alerts (CAP-CP Protocol & Concurrency)"]
        Router_Routes["/api/v1/routes (Hazard-Weighted A* Routing)"]
        Router_Shelters["/api/v1/shelters (Capacity & Assignment)"]
        Router_Hazards["/api/v1/hazards (Multi-Hazard Landslide & Flood)"]
        Router_Sim["/api/v1/simulation & /api/v1/simulation/scenarios"]
        Router_AI["/api/v1/ai/risk & /api/ai/risk (ML Inference)"]
        Router_Nat["/api/v1/national, /api/v1/historical"]
        
        UI_API --> Router_Auth
        UI_API --> Router_Forecast
        UI_API --> Router_Sensors
        UI_API --> Router_Catchment
        UI_API --> Router_Alerts
        UI_API --> Router_Routes
        UI_API --> Router_Shelters
        UI_API --> Router_Hazards
        UI_API --> Router_Sim
        UI_API --> Router_AI
        UI_API --> Router_Nat
    end

    subgraph Domain_Services ["Domain Services Layer (FastAPI / Python)"]
        Svc_Timeline["Timeline Service (Continuous Piecewise Lead-Time Solver)"]
        Svc_Risk["Risk Engine (Hydrologic Rules & Multi-Tier Aggregation)"]
        Svc_Spatial["Spatial Voronoi & Catchment Geometry Service"]
        Svc_Sim["Simulation Engine & Scenario Runner (5-Stage Cloudburst)"]
        Svc_Alert["Alert Engine (Atomic Dedup, Advisory Tagging, Concurrency)"]
        Svc_Route["Route Service (Hazard-Weighted Cost Multipliers & Snap)"]
        Svc_Landslide["Landslide Service (GSI / Caine 1980 Empirical Slope)"]
        Svc_Forecast["Forecast & Soil Uncertainty Service"]
        Svc_Freshness["Telemetry Freshness & Fallback Service"]
        Svc_AI["AI Service Adapter (ml/inference integration)"]
        
        Router_Forecast --> Svc_Timeline
        Router_Sensors --> Svc_Risk
        Router_Catchment --> Svc_Spatial
        Router_Sim --> Svc_Sim
        Router_Alerts --> Svc_Alert
        Router_Routes --> Svc_Route
        Router_Shelters --> Svc_Spatial
        Router_Hazards --> Svc_Landslide
        Router_Hazards --> Svc_Risk
        Router_AI --> Svc_AI
        
        Svc_Timeline --> Svc_Risk
        Svc_Timeline --> Svc_AI
        Svc_Sim --> Svc_Risk
        Svc_Risk --> Svc_Alert
        Svc_Landslide --> Svc_Alert
        Svc_Risk --> Svc_Route
        Svc_AI --> Svc_Risk
        Svc_Forecast --> Svc_Risk
        Svc_Freshness --> Svc_Risk
    end

    subgraph ML_Subsystem ["Machine Learning Subsystem (ml/)"]
        ML_Infer["Inference Service (ml/inference/predict.py)"]
        ML_Calib["Calibration Service (Platt & Isotonic Regressors)"]
        ML_Eval["Model Evaluation (ml/evaluation/evaluate_flood_model.py)"]
        ML_Train["Training Pipeline (ml/training/study_model_selection.py)"]
        ML_Prep["Feature Preprocessing Pipeline (ml/preprocessing/pipeline.py)"]
        ML_Configs["Configs & Catalog (ml/configs/*.json)"]
        ML_Artifacts["Trained Artifacts (ml/artifacts/xgboost_flood_model.json)"]
        
        Svc_AI --> ML_Infer
        Svc_Timeline --> ML_Calib
        ML_Calib --> ML_Infer
        ML_Infer --> ML_Artifacts
        ML_Infer --> ML_Configs
        ML_Train --> ML_Prep
        ML_Train --> ML_Artifacts
        ML_Train --> ML_Configs
        ML_Eval --> ML_Artifacts
        ML_Eval --> ML_Prep
    end

    subgraph Data_Storage ["Persistence & External Data Ingestion"]
        DB_SQL["SQLAlchemy DB (SQLite / PostgreSQL with PostGIS)"]
        Real_Data["Verified Real Data (data/real/ ERA5, IndoFloods, Beas Basin)"]
        External_APIs["External APIs (Open-Meteo ERA5, IMD, CWC Telemetry)"]
        
        Svc_Timeline --> DB_SQL
        Svc_Risk --> DB_SQL
        Svc_Spatial --> DB_SQL
        Svc_Sim --> DB_SQL
        Svc_Alert --> DB_SQL
        Svc_Route --> DB_SQL
        Svc_Landslide --> DB_SQL
        ML_Prep --> Real_Data
        Real_Data -.-> External_APIs
    end

    %% Class styles
    classDef client fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef gateway fill:#0f172a,stroke:#818cf8,stroke-width:2px,color:#f8fafc;
    classDef services fill:#111827,stroke:#34d399,stroke-width:2px,color:#f8fafc;
    classDef ml fill:#311042,stroke:#c084fc,stroke-width:2px,color:#f8fafc;
    classDef data fill:#1c1917,stroke:#fb923c,stroke-width:2px,color:#f8fafc;

    class UI_Pages,UI_Comp,UI_Hooks,UI_API client;
    class Router_Health,Router_Auth,Router_Forecast,Router_Sensors,Router_Catchment,Router_Alerts,Router_Routes,Router_Shelters,Router_Hazards,Router_Sim,Router_AI,Router_Nat gateway;
    class Svc_Timeline,Svc_Risk,Svc_Spatial,Svc_Sim,Svc_Alert,Svc_Route,Svc_Landslide,Svc_Forecast,Svc_Freshness,Svc_AI services;
    class ML_Infer,ML_Calib,ML_Eval,ML_Train,ML_Prep,ML_Configs,ML_Artifacts ml;
    class DB_SQL,Real_Data,External_APIs data;
